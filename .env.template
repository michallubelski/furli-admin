# Copy this file to `.env.local` and set the values for your environment.

# Development-only Vite proxy target. Frontend can call `/api/...`,
# and Vite forwards those requests to the backend below.
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional direct API base URL used by the browser.
# Set this only when the frontend should call the backend directly
# instead of going through the Vite dev proxy.
# VITE_API_BASE_URL=http://localhost:8080
