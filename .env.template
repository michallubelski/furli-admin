# Szablon zmiennych furli-admin do uruchomienia LOKALNIE (npm run dev / npm run build) - skopiuj
# do .env.local. Obraz Dockera dla dev/prod bierze zmienne z docker/.env.template, nie z tego pliku.
#
# Znaczniki (obowiazuja az do nastepnego znacznika):
#   - "@required local" - zmienna musi byc w pliku i miec wartosc
#   - "@optional"       - mozna pominac; wtedy dziala wartosc domyslna
# Sprawdzenie: scripts/check-env.sh.


# =================================================================================================
# 1. Backend
# =================================================================================================

# Tylko serwer deweloperski Vite: zapytania /api/... sa przekazywane do tego backendu.
# @required local
VITE_API_PROXY_TARGET=http://localhost:8080

# Bezposredni adres API dla przegladarki - ustaw tylko, gdy panel ma wolac backend z pominieciem
# proxy Vite. Pusty/pominiety = /api/... na tym samym originie.
# @optional
VITE_API_BASE_URL=
