# Skopiuj do docker/.env.dev lub docker/.env.prod NA SERWERZE danego srodowiska (nigdy nie
# commituj docker/.env.* - patrz .gitignore). Ta wartosc jest przekazywana jako build arg
# (docker/docker-compose.yml -> docker/Dockerfile) i wpiekana w bundel Vite w czasie budowy obrazu -
# zmiana wymaga przebudowania obrazu (`docker compose build`), nie tylko restartu kontenera.
#
# Puste = przegladarka woła /api/... "same-origin", a wewnetrzny docker/nginx.conf tego kontenera
# proxuje to do furli-backend:8080. Ten sam wpis dla dev i prod - panel admina nie uzywa Supabase po
# stronie przegladarki i nie ma tu dzis roznicy miedzy srodowiskami.
VITE_API_BASE_URL=
